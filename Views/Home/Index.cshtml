@{
    ViewData["Title"] = "Home Page";
}
<!-- HERO -->
<section class="hero">
    <div class="hero-left">
        <div class="hero-badge"><span></span>Mérida · Edición 2026</div>
        <h1 class="hero-title">Festival<br>del <em>Mollete</em></h1>
        <p class="hero-subtitle">Tradición · Sabor · Comunidad</p>
        <p class="hero-description">
            Bienvenido al festival que celebra uno de los platillos más queridos de la mesa mexicana. Un encuentro de cocineros, artesanos y amantes del buen sabor reunidos por el orgullo del mollete.
        </p>
        <a class="hero-cta" asp-area="" asp-controller="Catalogo" asp-action="Index">
            Descubre el catálogo
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>
    </div>
    <div class="hero-right">
        <div class="bread-illustration">🥖</div>
    </div>
</section>
 
<!-- STATS -->
<section class="stats">
    <div class="stat-item">
        <div class="stat-number">+10</div>
        <div class="stat-label">Años de tradición</div>
    </div>
    <div class="stat-item">
        <div class="stat-number">+50</div>
        <div class="stat-label">Recetas participantes</div>
    </div>
    <div class="stat-item">
        <div class="stat-number">Gratis</div>
        <div class="stat-label">Entrada libre</div>
    </div>
</section>
 
<!-- ABOUT -->
<section class="about">
    <div class="about-text">
        <div class="section-label">El evento</div>
        <h2 class="section-title">Del bolillo clásico<br>a la reinvención gourmet</h2>
        <p class="section-body">
            El Festival del Mollete reúne en un solo lugar la tradición y la creatividad de quienes llevan este ícono de la gastronomía nacional al siguiente nivel. Encontrarás desde el mollete de siempre —frijoles negros y queso Oaxaca gratinado— hasta propuestas que combinan ingredientes regionales con técnicas de vanguardia.
        </p>
        <p class="section-body">
            Más que un festival de comida, es un encuentro de comunidad, cultura y buen gusto donde cada bocado cuenta una historia.
        </p>
    </div>
    <div class="about-visual">
        <div class="quote-block">
            <span class="quote-mark">"</span>
            <p class="quote-text">Del bolillo al plato, el mollete es historia viva de nuestra cocina.</p>
            <p class="quote-author">Festival del Mollete · Querétaro</p>
        </div>
    </div>
</section>
 
<!-- ACTIVITIES -->
<section class="activities" id="actividades">
    <div class="activities-header">
        <div class="section-label">Qué encontrarás</div>
        <h2 class="section-title">Actividades del festival</h2>
    </div>
    <div class="activities-grid">
        <div class="activity-card">
            <div class="activity-icon">👨‍🍳</div>
            <div class="activity-name">Talleres gastronómicos</div>
            <div class="activity-desc">Aprende técnicas y secretos directamente de los cocineros participantes.</div>
        </div>
        <div class="activity-card">
            <div class="activity-icon">🏆</div>
            <div class="activity-name">Concurso de molletes</div>
            <div class="activity-desc">Creatividad y sabor se disputan el primer lugar. ¡Tú eliges al ganador!</div>
        </div>
        <div class="activity-card">
            <div class="activity-icon">🎶</div>
            <div class="activity-name">Música en vivo</div>
            <div class="activity-desc">El mejor sabor va acompañado de los mejores ritmos locales.</div>
        </div>
        <div class="activity-card">
            <div class="activity-icon">🧺</div>
            <div class="activity-name">Artesanías locales</div>
            <div class="activity-desc">Artesanos yucatecos exhiben y venden su trabajo durante el festival.</div>
        </div>
        <div class="activity-card">
            <div class="activity-icon">🎠</div>
            <div class="activity-name">Área infantil</div>
            <div class="activity-desc">Actividades y juegos pensados para los más pequeños de la familia.</div>
        </div>
    </div>
</section>
 
<!-- FOOTER -->
<footer>
    <div class="footer-brand">Festival del Mollete</div>
    <div class="footer-info">Mérida, Yucatán · 2026 · Entrada gratuita</div>
</footer>

