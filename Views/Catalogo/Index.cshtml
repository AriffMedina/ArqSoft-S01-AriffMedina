@model List<Catalogo.Models.Item>

<head>
    <link href="~/css/catalogo.css" rel="stylesheet" />
</head>


<div class="catalogo-hero">
    <div class="catalogo-hero-inner">
        <div class="catalogo-badge">
            <span></span>
            Festival del Mollete &middot; 2026
        </div>
        <h1>Nuestro <em>Catálogo</em></h1>
        <p class="catalogo-hero-sub">Explora todos los molletes del festival</p>
    </div>
</div>

<div class="contenedor-catalogo">

    
    <div class="catalogo-toolbar">
        <div class="filtros-categoria">
            <a asp-action="Index">Todos</a>
            @foreach (var gen in ViewBag.Categorias as List<string>)
            {
                <span> | </span>
                <a asp-action="Index" asp-route-genero="@gen">@gen</a>
            }
        </div>
        <a asp-action="Agregar" class="btn-agregar">+ Agregar Mollete</a>
    </div>

    
    <ul class="lista-molletes">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <li>
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="titulo-mollete">@item.Nombre</a>
                    <span class="info-mollete">@item.Categoria &nbsp;·&nbsp; @item.Precio</span>
                </li>
            }
        }
        else
        {
            <li class="catalogo-empty">
                <p>Aún no hay molletes en el catálogo.</p>
            </li>
        }
    </ul>

</div>
