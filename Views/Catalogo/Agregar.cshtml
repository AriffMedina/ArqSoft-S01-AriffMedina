@model Catalogo.Models.Item

<head>
    <link href="~/css/agregar.css" rel="stylesheet" />
</head>

<div class="contenedor-formulario">
    <div class="tarjeta-formulario">
        <h1>Agregar mollete</h1>
        
        <form asp-action="Agregar" method="post">
            <div class="grupo-campo">
                <label>Nombre</label>
                <input asp-for="Nombre" placeholder="Ej. Mollete Clásico" />
            </div>
            
            <div class="grupo-campo">
                <label>Categoría</label>
                <input asp-for="Categoria" placeholder="Ej. Tradicional, Dulce, Gourmet..." />
            </div>
            
            <div class="grupo-campo">
                <label>Descripción</label>
                <input asp-for="Descripcion" placeholder="Breve descripción del platillo" />
            </div>
            
            <div class="grupo-campo">
                <label>Precio</label>
                <input asp-for="Precio" type="number" step="0.50" placeholder="0.00" />
            </div>
            
            <div class="grupo-campo">
                <label>Ingredientes</label>
                <textarea asp-for="Ingredientes" rows="4" placeholder="Lista de ingredientes..."></textarea>
            </div>
            
            <div class="acciones-formulario">
                <button type="submit" class="btn-guardar">Guardar</button>
                <a asp-action="Index" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>